# ── SRI Command Center API — environment template ────────────────────────────
# Copy to .env and fill in real values. NEVER commit .env.

# ── Google Drive ──────────────────────────────────────────────────────────────
# Path to your service-account credentials JSON downloaded from GCP console.
# The service account needs read access to the SRI Agent Platform Drive folder.
GOOGLE_SERVICE_ACCOUNT_FILE=./credentials/sri-service-account.json
# Production alternative: the full service-account JSON stored as a secret.
GOOGLE_SERVICE_ACCOUNT_JSON=

# The Google Drive folder ID that is the root of the SRI Agent Platform.
# Find it in the Drive URL: drive.google.com/drive/folders/<FOLDER_ID>
DRIVE_ROOT_FOLDER_ID=

# Subfolder inside the root where OS signal files live (default: signals)
DRIVE_SIGNALS_FOLDER_NAME=signals

# How often (seconds) to re-poll Drive for new signal files.
DRIVE_POLL_INTERVAL=30

# Durable Notebook / Mission Control state. Keep false until the service account
# has access only to the intended SRI Drive root. When enabled, notes, tasks, and
# dashboard-created projects are stored in one versioned JSON state file.
DASHBOARD_DRIVE_WRITE_ENABLED=false
DASHBOARD_STATE_FOLDER_ID=
DASHBOARD_STATE_FILE_NAME=sri-command-center-state.json

# Canonical Platform Agent session-summaries folder. Session Briefs are
# read-only. Private summary text is never bundled into the public repository.
DASHBOARD_SESSION_SUMMARIES_FOLDER_ID=18izBaGlyEQBF8aWaGRajxTRp_oO9ejWk

# ── GitHub ────────────────────────────────────────────────────────────────────
# Personal access token (classic) or fine-grained token with:
#   repo:read, actions:read, pull_requests:read
GITHUB_TOKEN=

# Comma-separated list of org/repo slugs to watch for Builder OS projects.
# e.g.  sri-intel/command-center,sri-intel/marketing-engine
GITHUB_REPOS=

# GitHub org name (used for org-level queries)
GITHUB_ORG=sri-intel

# ── Server ────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# Comma-separated allowed CORS origins (Vite dev server + any deployed frontend)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ── Cache ─────────────────────────────────────────────────────────────────────
# In-memory TTL (seconds) for Drive and GitHub responses
CACHE_TTL=60

# ── Legal Agent OS ───────────────────────────────────────────────────────────
# SQLite is the transactional queue; Google Drive remains the document system
# of record. Use a persistent path on the VPS before enabling live intake.
LEGAL_ENABLED=true
LEGAL_STATE_DB=./data/legal-os-state.db
LEGAL_STATE_PERSISTENT=false
LEGAL_MAX_ACTIVE_MATTERS=4

# Optional server-to-server fallback. Never expose it in Vite/browser variables.
LEGAL_API_TOKEN=

# Jeff-only dashboard access. Create a Google OAuth 2.0 Web client with the
# dashboard URL as an authorized JavaScript origin. The client ID is public;
# the session secret must be a random value of at least 32 characters.
LEGAL_GOOGLE_CLIENT_ID=
LEGAL_GOOGLE_WORKSPACE_DOMAIN=sri-intel.com
LEGAL_SESSION_SECRET=
LEGAL_SESSION_TTL_SECONDS=1800
LEGAL_OPERATOR_EMAIL=jeff@sri-intel.com

# Manual intake remains unavailable until both flags are true. Only set
# LEGAL_STATE_PERSISTENT=true when LEGAL_STATE_DB is on a mounted disk.
LEGAL_MANUAL_INTAKE_ENABLED=false

# Offline Google user grant JSON for jeff@sri-intel.com. Store this only as a
# secret environment value. ADC is an explicit local-development fallback.
LEGAL_GOOGLE_USER_TOKEN_JSON=
LEGAL_GOOGLE_ALLOW_ADC=false

# Keep false until Gmail OAuth has the gmail.modify scope and the live runner
# has passed shadow-mode verification.
LEGAL_GMAIL_ENABLED=false
LEGAL_GMAIL_SHADOW_MODE=true
LEGAL_GMAIL_POLL_INTERVAL=60
LEGAL_GMAIL_INTAKE_LABEL=LegalOS/Intake
LEGAL_GMAIL_PROCESSED_LABEL=LegalOS/Processed
LEGAL_GMAIL_NEEDS_REVIEW_LABEL=LegalOS/NeedsReview
LEGAL_GMAIL_ERROR_LABEL=LegalOS/Error

# Canonical Legal Agent OS / Matters folder. Required before the Gmail runner
# can be enabled; messages are not marked processed until Drive persistence
# succeeds.
LEGAL_DRIVE_MATTERS_FOLDER_ID=
LEGAL_ATTACHMENT_MAX_BYTES=25000000
