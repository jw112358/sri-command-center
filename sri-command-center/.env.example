# SRI OS Command Center — frontend environment
# Copy to .env.local and adjust as needed

# URL of the FastAPI backend (no trailing slash)
# Default: http://localhost:8000
VITE_API_URL=http://localhost:8000

# Optional local design mode only. Production ignores mock records unless this
# is explicitly true in a development build.
VITE_ALLOW_MOCK_DATA=false
